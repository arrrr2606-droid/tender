# Токен бота от @BotFather
TELEGRAM_TOKEN=
# ID чата, куда слать лоты. Если не знаете — оставьте пустым, запустите и напишите боту /start:
# он ответит вашим chat id. Для группы: добавьте бота в группу и напишите /start там.
TELEGRAM_CHAT_ID=
# Необязательно: прокси только для Telegram, если api.telegram.org недоступен с сервера
# TELEGRAM_PROXY=socks5://user:pass@host:1080
